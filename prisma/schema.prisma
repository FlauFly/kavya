generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model authors {
  id    Int     @id @default(autoincrement())
  name  String
  bio   String?
  works works[]
}

model genres {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  work_genres work_genres[]
}

model languages {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  log_languages log_languages[]
  works         works[]
}

model log_languages {
  log_id         Int
  language_id    Int
  languages      languages      @relation(fields: [language_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_work_logs user_work_logs @relation(fields: [log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([log_id, language_id])
}

model moods {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  log_moods log_moods[]
}

model sources {
  id           Int            @id @default(autoincrement())
  name         String
  source_type  source_type    @default(other)
  cover_url    String?
  created_by   Int?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  users        users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  work_sources work_sources[]
}

model user_work_logs {
  id            Int             @id @default(autoincrement())
  user_id       Int
  work_id       Int
  status        log_status      @default(want_to_read)
  read_at       DateTime?       @db.Date
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  review        String?         @db.VarChar(1000)
  log_languages log_languages[]
  log_moods     log_moods[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works         works           @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, work_id])
}

model users {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  email          String           @unique
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  sources        sources[]
  user_work_logs user_work_logs[]
  works          works[]
}

model work_genres {
  work_id  Int
  genre_id Int
  genres   genres @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works    works  @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([work_id, genre_id])
}

model work_sources {
  work_id   Int
  source_id Int
  sources   sources @relation(fields: [source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works     works   @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([work_id, source_id])
}

model works {
  id                   Int              @id @default(autoincrement())
  title                String
  form                 work_form
  author               Int
  original_language_id Int?
  synopsis             String?
  word_count           Int?
  created_by           Int?
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  user_work_logs       user_work_logs[]
  work_genres          work_genres[]
  work_sources         work_sources[]
  authors              authors          @relation(fields: [author], references: [id], onUpdate: NoAction)
  users                users?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  languages            languages?       @relation(fields: [original_language_id], references: [id], onUpdate: NoAction)
}

model log_moods {
  log_id         Int
  mood_id        Int
  user_work_logs user_work_logs @relation(fields: [log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  moods          moods          @relation(fields: [mood_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([log_id, mood_id])
}

enum log_status {
  want_to_read
  read
}

enum source_type {
  magazine
  anthology
  website
  other
}

enum work_form {
  short_story
  poetry
}
